  };

  const CIRCLED = ['①', '②', '③', '④', '⑤', '⑥', '⑦', '⑧'];

  /**
   * 把数值范围映射到像素。
   * @param {number} v 值
   * @param {number} lo 数据下界
   * @param {number} hi 数据上界
